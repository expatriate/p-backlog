{
  "name": "p-backlog",
  "version": "0.2.2",
  "description": "Personal developer backlog for Claude Code: tasks as Markdown files, CLI, Stop hook and a local web UI",
  "keywords": [
    "claude-code",
    "claude",
    "anthropic",
    "ai-agents",
    "coding-agent",
    "agent-skills",
    "backlog",
    "task-management",
    "tech-debt",
    "todo",
    "developer-tools",
    "productivity",
    "cli",
    "markdown",
    "local-first"
  ],
  "homepage": "https://github.com/expatriate/p-backlog#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/expatriate/p-backlog.git"
  },
  "bugs": {
    "url": "https://github.com/expatriate/p-backlog/issues"
  },
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "files": [
    "dist/cli.js",
    "dist/server.js",
    "dist/web",
    "skill",
    "README.md",
    "README.ru.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "vitest run",
    "lint": "eslint . && knip && node scripts/check-cyrillic.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "build": "vite build && node scripts/build-node.mjs",
    "install-skill": "node dist/cli.js setup",
    "start": "npm run build && node dist/server.js",
    "dev": "concurrently -k -n server,web \"tsx watch src/server/main.ts\" \"vite\"",
    "test:e2e": "playwright test",
    "test:package": "vitest run --config vitest.package.config.ts",
    "prepare": "npm run build",
    "test:coverage": "vitest run --coverage",
    "knip": "knip"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "chokidar": "^5.0.0",
    "hono": "^4.13.8",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tanstack/react-query": "^5.103.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.1",
    "concurrently": "^10.0.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^30.1.0",
    "knip": "^6.37.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-is": "^19.3.0",
    "react-markdown": "^10.1.0",
    "react-router": "^8.4.0",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "bin": {
    "backlog": "dist/cli.js"
  }
}
