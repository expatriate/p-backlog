<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>local.p-backlog</string>
  <key>ProgramArguments</key>
  <array>
    <string>NODE_PATH</string>
    <string>REPO_PATH/dist/server.js</string>
  </array>
  <key>WorkingDirectory</key>
  <string>REPO_PATH</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>BACKLOG_DIR</key>
    <string>HOME_PATH/backlog</string>
    <key>PORT</key>
    <string>4317</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>HOME_PATH/Library/Logs/p-backlog.log</string>
  <key>StandardErrorPath</key>
  <string>HOME_PATH/Library/Logs/p-backlog.log</string>
</dict>
</plist>
